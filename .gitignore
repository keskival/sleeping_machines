# Local datasets and Python environments.
data/
.venv/
.venv-*/

# Generated Python bytecode and test/tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Host-local locks and editor files.
*.lock
*.swp
*.swo
*~
.DS_Store

# Large per-example output from the early E2 experiment.
experiments/results/e2/rows.json

# Generated run artifacts stay local; retain queue commands and result JSON.
experiments/queue/**/*.log
experiments/queue/**/*.out
experiments/results/**/*.pt
experiments/results/**/*.npy
experiments/results/**/*.npz
experiments/results/**/*.log
experiments/results/**/*.out
# Live benchmark progress stays local; completed result summaries are tracked.
experiments/results/**/*.running.json
experiments/results/**/*.pt.tmp
experiments/results/**/*.json.tmp
experiments/queue/*.status.json
report/*.building.pdf
